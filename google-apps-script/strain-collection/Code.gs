////////////////////////////////////////////////////////////////////////////
//                   Utilities                                            //
////////////////////////////////////////////////////////////////////////////
// Record date / Request date are saved with the time (so same-day strains sort in order),
// but the table only shows the date. Click a cell to see the full time in the formula bar.
const DATE_FORMAT = 'yyyy-mm-dd';

function getDateIsoFormat() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function getSheetOrFail(name) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  if (!sheet) throw new Error('Could not find a sheet called "' + name + '". Check CONFIG at the top of Code.gs.');
  return sheet;
}

function getStrains() { return getSheetOrFail(CONFIG.strainsSheet); }
function getRequests() { return getSheetOrFail(CONFIG.requestsSheet); }
function getReturns() { return getSheetOrFail(CONFIG.returnsSheet); }

// https://stackoverflow.com/questions/36120938/go-to-last-line-of-data-in-google-sheets
function goToLastLine() {
  const sheet = SpreadsheetApp.getActiveSheet();
  SpreadsheetApp.setActiveRange(sheet.getRange(Math.max(1, sheet.getLastRow()), 1));
}

// Sorts the Strains or Requests tab (whichever is open) by Record date / Request date.
// Rows without a date go to the bottom.
function sortNewestFirst() { sortByDate(false); }
function sortOldestFirst() { sortByDate(true); }

function sortByDate(ascending) {
  const sheet = SpreadsheetApp.getActiveSheet();
  let headerRow, dateCol, nCols;
  if (sheet.getName() === CONFIG.strainsSheet) {
    headerRow = getHeaderRow(); dateCol = 5; nCols = CONFIG.strainHeaders.length;
  } else if (sheet.getName() === CONFIG.requestsSheet) {
    headerRow = CONFIG.requestHeaderRows; dateCol = 2; nCols = requestLinkCol() + 2;
  } else {
    SpreadsheetApp.getUi().alert('Open the ' + CONFIG.strainsSheet + ' or ' + CONFIG.requestsSheet + ' tab first.');
    return;
  }
  const nRows = sheet.getLastRow() - headerRow;
  if (nRows < 2) return;
  withLock(() => {
    stampMissingTimes(sheet.getRange(headerRow + 1, dateCol, nRows, 1));
    sheet.getRange(headerRow + 1, 1, nRows, Math.max(nCols, sheet.getLastColumn()))
      .sort({ column: dateCol, ascending: ascending });
  });
  sheet.setActiveRange(sheet.getRange(headerRow + 1, 1));
  SpreadsheetApp.getActive().toast(ascending ? 'Oldest first' : 'Newest first');
}

// Older rows only have a date (time 00:00), so same-day rows would tie when sorting.
// Gives them hidden seconds in their current row order (top = added first), once.
// After that every row has its own time and the sort always keeps the order they were added in.
function stampMissingTimes(dateRange) {
  const values = dateRange.getValues();
  const seen = {};
  let changed = false;
  const out = values.map(([v]) => {
    let d = v;
    if (typeof v === 'string') {
      const m = v.trim().match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
      if (!m) return [v];
      d = new Date(+m[1], +m[2] - 1, +m[3]);
    }
    if (!(d instanceof Date) || isNaN(d)) return [v];
    if (d.getHours() || d.getMinutes() || d.getSeconds()) return [v];
    const day = d.getFullYear() + '-' + d.getMonth() + '-' + d.getDate();
    const k = seen[day] = (seen[day] || 0) + 1;
    changed = true;
    return [new Date(d.getFullYear(), d.getMonth(), d.getDate(), 0, 0, k)];
  });
  if (changed) dateRange.setValues(out).setNumberFormat(DATE_FORMAT);
}

// Returns [date, version]; with increment = true, stamps today's date and bumps the version
function accessDateAndVersion(increment) {
  const strainsSheet = getStrains();
  const versionCell = strainsSheet.getRange(CONFIG.versionCell);
  const dateCell = strainsSheet.getRange(CONFIG.dateCell);
  let version = parseInt(versionCell.getValue(), 10) || 0;
  let date = dateCell.getDisplayValue();
  if (increment) {
    date = getDateIsoFormat();
    dateCell.setValue(date);
    version++;
    versionCell.setValue(version);
  }
  return [date, version];
}

// Run "setupDailyBackupTrigger" once from the editor to back up every night,
// or attach createBackup to a time trigger yourself (Triggers > Add trigger).
function createBackup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const version = accessDateAndVersion(false)[1];
  const saveName = ss.getName() + '_backup_' + getDateIsoFormat() + '_v' + version;
  console.log(saveName);
  DriveApp.getFileById(ss.getId()).makeCopy(saveName, DriveApp.getFolderById(CONFIG.backupsFolderId));
  return saveName;
}

// Menu version: tells the user it worked
function createBackupFromMenu() {
  const saveName = createBackup();
  SpreadsheetApp.getActive().toast('Backup saved as ' + saveName);
}

function setupDailyBackupTrigger() {
  ScriptApp.getProjectTriggers()
    .filter(t => t.getHandlerFunction() === 'createBackup')
    .forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('createBackup').timeBased().everyDays(1).atHour(2).create();
}

// Returns [lab code, allele code]
function getPrefixes() {
  const sheet = getStrains();
  return [CONFIG.labCode || sheet.getRange(CONFIG.labCodeCell).getValue(),
          CONFIG.alleleCode || sheet.getRange(CONFIG.alleleCodeCell).getValue()];
}

// Returns the range with the transgene names / abbreviations / next numbers,
// trimmed to the last column that has a name. An empty abbreviation is allowed:
// e.g. "Allele" with no abbreviation gives plain allele names like vrt26.
function getTransgeneRange() {
  const sheet = getStrains();
  let lastCol = CONFIG.transgeneMaxCols;
  const info = sheet.getRange(CONFIG.transgeneFirstRow, 1, 3, lastCol).getValues();
  while (lastCol > 1 && info[0][lastCol - 1] === '') {
    lastCol--;
  }
  return sheet.getRange(CONFIG.transgeneFirstRow, 1, 3, lastCol);
}

// Returns [next strain number, [[names...], [abbrevs...], [next numbers...]]], for ex:
// [42, [['Integrant', 'Extrachromosomal'], ['Is', 'Ex'], [510, 33]]]
function getTransgenesLine() {
  const info = getTransgeneRange().getValues();
  return [info[2][0], info.map(row => row.slice(1))];
}

////////////////////////////////////////////////////////////////////////////
//    Strain creation: sending info and processing submitted values       //
////////////////////////////////////////////////////////////////////////////

// Makes rows 4-5 of the Strains sheet match CONFIG.strainTypes, so the form always offers
// those types. Next numbers already on the sheet are kept for types with the same name;
// new types start at their CONFIG number. The next strain number (A6) is never touched.
function syncStrainTypes() {
  const sheet = getStrains();
  const row = CONFIG.transgeneFirstRow;
  const current = sheet.getRange(row, 1, 3, CONFIG.transgeneMaxCols).getValues();
  const types = CONFIG.strainTypes;
  const same = types.every((t, i) => current[0][i + 1] === t[0] && current[1][i + 1] === t[1]) &&
               current[0][types.length + 1] === '';
  if (same) return;
  const oldNext = {};
  current[0].forEach((name, i) => { if (i > 0 && name !== '') oldNext[name] = current[2][i]; });
  sheet.getRange(row, 2, 3, CONFIG.transgeneMaxCols - 1).clearContent();
  sheet.getRange(row, 2, 3, types.length).setValues([
    types.map(t => t[0]),
    types.map(t => t[1]),
    types.map(t => (oldNext[t[0]] !== undefined && oldNext[t[0]] !== '') ? oldNext[t[0]] : t[2]),
  ]);
  if (current[0][0] === '') sheet.getRange(row, 1).setValue('Next free # on line below');
  if (current[1][0] === '') sheet.getRange(row + 1, 1).setValue('Strain number');
  if (current[2][0] === '') sheet.getRange(row + 2, 1).setValue(CONFIG.firstStrainNumber);
  SpreadsheetApp.flush();
}

// Returns [lab code, allele code, next strain number, [transgene classes and numbers]]
function createTransgeneList() {
  withLock(syncStrainTypes);
  const prefixes = getPrefixes();
  const transgenes = getTransgenesLine();
  return [prefixes[0], prefixes[1], transgenes[0], transgenes[1]];
}

// Bumps the next available numbers. Must be called while holding the script lock.
// typeToIncrement: 0 = no transgene, 1 = first transgene column, 2 = second...
function modTransgeneLines(typeToIncrement, nbrToIncrement) {
  syncStrainTypes();
  const transgeneRange = getTransgeneRange();
  const strainCell = transgeneRange.getCell(3, 1);
  const newStrainNbr = parseInt(strainCell.getValue(), 10);
  if (isNaN(newStrainNbr)) throw new Error('The next strain number (cell A6) is not a number.');
  strainCell.setValue(newStrainNbr + nbrToIncrement);
  let newTypeNbr = 0;
  let newTypeAbbrev = '';
  if (typeToIncrement > 0) {
    const typeCell = transgeneRange.getCell(3, typeToIncrement + 1);
    newTypeNbr = parseInt(typeCell.getValue(), 10);
    if (isNaN(newTypeNbr)) throw new Error('The next number for this transgene type is not a number.');
    typeCell.setValue(newTypeNbr + nbrToIncrement);
    newTypeAbbrev = transgeneRange.getCell(2, typeToIncrement + 1).getValue();
  }
  return [newStrainNbr, newTypeNbr, newTypeAbbrev];
}

function withLock(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(CONFIG.lockTimeoutMs); // milliseconds; throws if someone else holds it too long
  try {
    const result = fn();
    SpreadsheetApp.flush();
    return result;
  } finally {
    lock.releaseLock();
  }
}

////////////////////////////////////////////////////////////////////////////
//    Link columns: Source / Order page / WormBase                        //
////////////////////////////////////////////////////////////////////////////
const SOURCES = ['Own lab', 'CGC', 'NBRP', 'Other lab'];

// The column header row. Looks in the top 20 rows for column B saying "Genotype",
// otherwise takes the row just above the first strain name (e.g. ABC1, CB1370) below the
// transgene table. Falls back to CONFIG.headerRow.
function getHeaderRow() {
  const top = getStrains().getRange(1, 1, 20, 2).getDisplayValues();
  for (let i = 0; i < top.length; i++) {
    if (/genotype|alleles/i.test(top[i][1])) return i + 1;
  }
  const firstDataRow = CONFIG.transgeneFirstRow + 3;
  for (let i = firstDataRow - 1; i < top.length; i++) {
    if (/^[A-Z]{1,5}\d+$/.test(top[i][0].trim())) return i;
  }
  return CONFIG.headerRow;
}

// Works out where a strain comes from: the Source cell if filled in, "Own lab" for your
// lab code + a number, "CGC" if the CGC has it, otherwise "Other lab".
function resolveSource(strainName, hint) {
  const name = String(strainName || '').trim();
  const h = String(hint || '');
  if (SOURCES.indexOf(h) !== -1) return h;
  if (/cgc/i.test(h)) return 'CGC';
  if (/nbrp/i.test(h)) return 'NBRP';
  const labCode = String(getPrefixes()[0] || '');
  if (labCode && name.indexOf(labCode) === 0 && /^\d+$/.test(name.slice(labCode.length))) return 'Own lab';
  try {
    if (lookupCgcStrain(name)) return 'CGC';
  } catch (e) {
    console.log('CGC check failed for ' + name + ': ' + e);
  }
  return 'Other lab';
}

function wormbaseUrl(strainName) {
  return 'https://wormbase.org/search/strain/' + encodeURIComponent(strainName);
}

// Order / source page for a strain, or '' when there is none
function orderUrl(source, strainName) {
  if (source === 'CGC') return 'https://cgc.umn.edu/strain/' + encodeURIComponent(strainName);
  if (source === 'NBRP') return 'https://shigen.nig.ac.jp/c.elegans/';
  return '';
}

function hyperlinkFormula(url, label) {
  return url ? '=HYPERLINK("' + url + '","' + label + '")' : '';
}

// First of the three link columns on the Requests sheet (Source, Order link, WormBase):
// right after the request info and the copied strain columns
function requestLinkCol() {
  return CONFIG.requestInfoCols + CONFIG.strainHeaders.length + 1;
}

// Writes Source + Order link + WormBase link on one Requests row
function writeLinkCells(sheet, row, source, strainName) {
  const col = requestLinkCol();
  const order = orderUrl(source, strainName);
  // Own-lab strains are only on WormBase once deposited, so they get no WormBase link
  const wormbase = source && source !== 'Own lab' ? wormbaseUrl(strainName) : '';
  sheet.getRange(row, col).setValue(source);
  sheet.getRange(row, col + 1, 1, 2).setFormulas([[
    hyperlinkFormula(order, source === 'CGC' ? 'Order on CGC' : 'Request from NBRP'),
    hyperlinkFormula(wormbase, 'WormBase'),
  ]]);
}

////////////////////////////////////////////////////////////////////////////
//    Strain name prefixes for strains from other labs (OH1074, SH1009)   //
////////////////////////////////////////////////////////////////////////////
// Each prefix is one shared number series: anyone may add the next OH strain.
// The Prefixes sheet records which lab or person each prefix belongs to, so a new
// prefix can be checked before anyone starts using it.

// All strain names in column A of the Strains sheet
function getStrainNames() {
  const sheet = getStrains();
  const first = getHeaderRow() + 1;
  const last = sheet.getLastRow();
  if (last < first) return [];
  return sheet.getRange(first, 1, last - first + 1, 1).getDisplayValues()
    .map(r => r[0].trim()).filter(n => n !== '');
}

// Highest number used with this exact prefix (SH matches SH1008, not SHA12), or 0
function lastNumberForPrefix(prefix, names) {
  const re = new RegExp('^' + prefix + '(\\d+)$');
  let max = 0;
  (names || getStrainNames()).forEach(n => {
    const m = n.match(re);
    if (m) max = Math.max(max, parseInt(m[1], 10));
  });
  return max;
}

function strainNameExists(name) {
  const target = String(name).trim().toUpperCase();
  return getStrainNames().some(n => n.toUpperCase() === target);
}

// The Prefixes sheet, created on first use and filled with the prefixes already in use
function getPrefixesSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(CONFIG.prefixesSheet);
  if (!sheet) {
    sheet = ss.insertSheet(CONFIG.prefixesSheet);
    sheet.getRange(1, 1, 1, 5).setValues([['Prefix', 'Lab / person', 'Added', 'Note', 'Start numbering at']])
      .setFontWeight('bold');
    sheet.setFrozenRows(1);
    const found = {};
    getStrainNames().forEach(n => {
      const m = n.match(/^([A-Z]{1,5})\d+$/);
      if (m) found[m[1]] = true;
    });
    const labCode = String(getPrefixes()[0] || '');
    const rows = Object.keys(found).sort().map(p => [p, p === labCode ? 'Our lab' : '',
      getDateIsoFormat(), 'Found in the Strains sheet; fill in whose it is']);
    if (labCode && !found[labCode]) rows.unshift([labCode, 'Our lab', getDateIsoFormat(), 'Our own strains']);
    if (rows.length) sheet.getRange(2, 1, rows.length, 4).setValues(rows);
  }
  // Sheets made by an earlier version have no "Start numbering at" column yet
  if (sheet.getRange(1, 5).getValue() === '') sheet.getRange(1, 5).setValue('Start numbering at').setFontWeight('bold');
  return sheet;
}

// "Start numbering at" from the Prefixes sheet (column E), or 1
function prefixStartNumber(prefix) {
  const sheet = getPrefixesSheet();
  if (sheet.getLastRow() < 2) return 1;
  const row = sheet.getRange(2, 1, sheet.getLastRow() - 1, 5).getDisplayValues()
    .find(r => r[0].trim().toUpperCase() === prefix);
  return row && parseInt(row[4], 10) > 0 ? parseInt(row[4], 10) : 1;
}

// Next free number: one more than the highest used, but never below "Start numbering at"
function nextNumberForPrefix(prefix, names) {
  return Math.max(lastNumberForPrefix(prefix, names) + 1, prefixStartNumber(prefix));
}

// Called by the form: [{prefix, owner, last, nextNumber}] for the prefix picker
function listStrainPrefixes() {
  const sheet = getPrefixesSheet();
  const names = getStrainNames();
  const last = sheet.getLastRow();
  if (last < 2) return [];
  return sheet.getRange(2, 1, last - 1, 5).getDisplayValues()
    .filter(r => r[0].trim() !== '')
    .map(r => {
      const prefix = r[0].trim().toUpperCase();
      const n = lastNumberForPrefix(prefix, names);
      const start = parseInt(r[4], 10) > 0 ? parseInt(r[4], 10) : 1;
      return { prefix: prefix, owner: r[1], last: n ? prefix + n : '', nextNumber: Math.max(n + 1, start) };
    });
}

// Is the CGC lab code page there? Returns the lab's name, '' if unknown, or null if no such lab.
function cgcLabName(prefix) {
  const res = UrlFetchApp.fetch('https://cgc.umn.edu/laboratory/' + encodeURIComponent(prefix),
                                { muteHttpExceptions: true, followRedirects: true });
  if (res.getResponseCode() !== 200) return null;
  const rows = res.getContentText().match(/<tr[\s\S]*?<\/tr>/gi) || [];
  if (!rows.length) return null;
  const fields = {};
  rows.forEach(row => {
    const cells = row.match(/<t[hd][^>]*>[\s\S]*?<\/t[hd]>/gi) || [];
    if (cells.length >= 2) fields[htmlToText(cells[0]).replace(/:$/, '').toLowerCase()] = htmlToText(cells[1]);
  });
  return fields['head'] || fields['name'] || fields['investigator'] || fields['pi'] || '';
}

// Called by the form to add a new prefix. Checks, in order: the format, the Prefixes sheet,
// strain names already in the Strains sheet, and the CGC's official lab codes.
// A CGC match needs confirmAnyway = true (e.g. you are in Oliver Hobert's lab and want OH).
function registerStrainPrefix(prefixInput, owner, confirmAnyway, startAt) {
  const prefix = String(prefixInput || '').trim().toUpperCase();
  const start = parseInt(startAt, 10) || 1;
  if (start < 1) return { ok: false, message: 'The starting number must be 1 or more.' };
  if (!/^[A-Z]{1,5}$/.test(prefix)) {
    return { ok: false, message: 'Use 1 to 5 letters only, e.g. SH.' };
  }
  if (!String(owner || '').trim()) {
    return { ok: false, message: 'Say whose prefix it is, e.g. "Sumin Hong" or "Hobert lab".' };
  }
  return withLock(() => {
    const sheet = getPrefixesSheet();
    const taken = sheet.getLastRow() < 2 ? [] : sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getDisplayValues();
    const match = taken.find(r => r[0].trim().toUpperCase() === prefix);
    if (match) {
      return { ok: false, message: prefix + ' is already taken by ' + (match[1] || 'someone') +
        '. Pick it from the list if you belong to it, or choose another prefix (e.g. add a middle initial).' };
    }
    const used = lastNumberForPrefix(prefix);
    if (used) {
      return { ok: false, message: prefix + ' is already used in the Strains sheet (up to ' + prefix + used +
        '). Ask who owns it, or choose another prefix.' };
    }
    if (!confirmAnyway) {
      let lab = null;
      try { lab = cgcLabName(prefix); } catch (e) { console.log('CGC lab check failed: ' + e); }
      if (lab !== null) {
        return { ok: false, cgc: true, message: prefix + ' is the official CGC lab code for ' +
          (lab || 'a registered lab') + '. Only use it if you are in that lab.' };
      }
    }
    sheet.appendRow([prefix, String(owner).trim(), getDateIsoFormat(),
                     confirmAnyway ? 'Matches a CGC lab code' : '', start]);
    return { ok: true, prefix: prefix, next: prefix + start };
  });
}

// External strain (CGC / other labs).
// With a prefix, the name is the next free number for that prefix, worked out at save time,
// unless a number was typed in the form (e.g. OH15903 to follow the lab's own numbering).
function writeNewStrain(jsonData) {
  const prefix = String(jsonData.prefix || '').trim().toUpperCase();
  const firstToWrite = ['strain_number', 'geno', 'back', 'contents'].map(key => jsonData[key] || '');
  let comments = jsonData.comments || '';
  if (jsonData.original_name) {
    comments = 'Original name: ' + String(jsonData.original_name).trim() + (comments ? '. ' + comments : '');
  }
  const afterWriting = [comments].concat(['maintenance', 'author', 'availability', 'location'].map(key => jsonData[key] || ''));
  if (!prefix && !String(firstToWrite[0]).trim()) throw new Error('A strain name is required.');
  // "Comes from" CGC / NBRP is kept in "Publicly available?" when that is empty,
  // so a later request knows where to order the strain
  if (!afterWriting[3] && (jsonData.source === 'CGC' || jsonData.source === 'NBRP')) afterWriting[3] = jsonData.source;
  const toWrite = withLock(() => {
    if (prefix) {
      const typed = parseInt(jsonData.prefix_number, 10);
      if (jsonData.prefix_number && !(typed > 0)) throw new Error('The number must be a whole number above 0.');
      firstToWrite[0] = prefix + (typed > 0 ? typed : nextNumberForPrefix(prefix));
    }
    const name = String(firstToWrite[0]).trim();
    if (strainNameExists(name)) {
      throw new Error(name + ' is already in the collection. Use a different name.');
    }
    const row = [].concat(firstToWrite, [new Date()], afterWriting);
    const sheet = getStrains();
    sheet.appendRow(row);
    sheet.getRange(sheet.getLastRow(), 5).setNumberFormat(DATE_FORMAT);
    accessDateAndVersion(true);
    return row;
  });
  SpreadsheetApp.getActive().toast('Added your strain: ' + toWrite[0]);
  return toWrite;
}

// New strain(s) from your own lab: assign strain names (and transgene names) and write them
function dealWithNewStrain(jsonData) {
  const typeNbr = parseInt(jsonData.types, 10) || 0;
  const bulkNbr = parseInt(jsonData.quantity, 10) || 1;
  if (bulkNbr < 1 || bulkNbr > 100) throw new Error('Quantity must be between 1 and 100.');
  const geno = jsonData.geno || '';
  const prefixes = getPrefixes();
  const firstToWrite = ['back', 'contents'].map(key => jsonData[key] || '');
  const afterWriting = ['comments', 'maintenance', 'author', 'availability', 'location'].map(key => jsonData[key] || '');
  const today = new Date();

  // Number assignment and writing happen under one lock so two people can't get the same names
  const valuesToWrite = withLock(() => {
    // Check the names are free before any number is used up
    const existing = getStrainNames().map(n => n.toUpperCase());
    const firstNbr = parseInt(getTransgenesLine()[0], 10);
    for (let i = 0; i < bulkNbr; i++) {
      const name = prefixes[0] + (firstNbr + i);
      if (existing.indexOf(name.toUpperCase()) !== -1) {
        throw new Error(name + ' already exists. Fix the next strain number (cell A6) and try again.');
      }
    }
    const nextNbrs = modTransgeneLines(typeNbr, bulkNbr);
    const rows = [];
    for (let i = 0; i < bulkNbr; i++) {
      const newStrainName = prefixes[0] + (nextNbrs[0] + i);
      let actualGeno = geno;
      if (typeNbr > 0) {
        const newTransgeneName = prefixes[1] + nextNbrs[2] + (nextNbrs[1] + i);
        actualGeno = newTransgeneName + (geno === '' ? '' : '; ' + geno);
      }
      rows.push([newStrainName, actualGeno].concat(firstToWrite, [today], afterWriting));
    }
    const strains = getStrains();
    const startRow = strains.getLastRow() + 1;
    strains.getRange(startRow, 1, rows.length, rows[0].length).setValues(rows);
    strains.getRange(startRow, 5, rows.length, 1).setNumberFormat(DATE_FORMAT);
    accessDateAndVersion(true);
    return rows;
  });

  let textToDisplay = 'Added your strain(s): ' + valuesToWrite.map(x => x[0]).join(', ');
  if (typeNbr > 0) {
    textToDisplay += '\nCreated these genotypes: ' + valuesToWrite.map(x => x[1]).join(', ');
  }
  SpreadsheetApp.getActive().toast(textToDisplay);
  return valuesToWrite;
}

////////////////////////////////////////////////////////////////////////////
//    Looking up a strain on the CGC website (cgc.umn.edu/strain/NAME)    //
////////////////////////////////////////////////////////////////////////////

// Turns a bit of HTML into plain text
function htmlToText(html) {
  return html
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#0?39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

// Called from the "Look up on CGC" button. Returns null if the CGC has no such strain.
// Reads the "Strain Information" table: Name / Species / Genotype / Description / Mutagen / Made by / Laboratory
function lookupCgcStrain(strainName) {
  const name = String(strainName || '').trim();
  if (!/^[A-Za-z0-9_.-]+$/.test(name)) throw new Error('Type a strain name like CB1370 first.');
  const response = UrlFetchApp.fetch('https://cgc.umn.edu/strain/' + encodeURIComponent(name),
                                     { muteHttpExceptions: true, followRedirects: true });
  if (response.getResponseCode() !== 200) return null;
  const html = response.getContentText();
  const fields = {};
  const rows = html.match(/<tr[\s\S]*?<\/tr>/gi) || [];
  rows.forEach(row => {
    const cells = row.match(/<t[hd][^>]*>[\s\S]*?<\/t[hd]>/gi) || [];
    if (cells.length >= 2) {
      const label = htmlToText(cells[0]).replace(/:$/, '').toLowerCase();
      fields[label] = htmlToText(cells[1]);
    }
  });
  if (!fields['genotype']) return null;
  return {
    name: fields['name'] || name,
    species: fields['species'] || '',
    genotype: fields['genotype'] || '',
    description: fields['description'] || '',
    mutagen: fields['mutagen'] || '',
    madeBy: fields['made by'] || '',
    lab: fields['laboratory'] || '',
    url: 'https://cgc.umn.edu/strain/' + name,
  };
}

////////////////////////////////////////////////////////////////////////////
//                            Requesting strains                          //
////////////////////////////////////////////////////////////////////////////

// Compares only the first n values of a against b
function arraysEqualFirstVals(a, b, n) {
  if (a === b) return true;
  if (a == null || b == null) return false;
  for (let i = 0; i < Math.min(a.length, n); ++i) {
    if (a[i] !== b[i]) return false;
  }
  return true;
}

// A location counts as valid if it mentions a box, e.g. "Box 12, slot 3"
function isLocationMissing(strainLocation) {
  return !(strainLocation && strainLocation.toString().toLowerCase().indexOf('box') !== -1);
}

// Was a strain previously requested? Was it returned? When?
function findLastTimeRequested(requestSheet, cellsToSearchOn) {
  const leftOffset = CONFIG.requestInfoCols;
  const firstDataRow = CONFIG.requestHeaderRows + 1;
  const requestCount = requestSheet.getLastRow() - CONFIG.requestHeaderRows;
  if (requestCount < 1) return null;
  const contents = requestSheet
    .getRange(firstDataRow, 1, requestCount, cellsToSearchOn.length + leftOffset)
    .getDisplayValues();
  const dates = requestSheet.getRange(firstDataRow, 2, requestCount, 1).getValues();
  // The sheet may be sorted, so pick the newest request date rather than the bottom row
  let best = null, bestTime = -Infinity;
  contents.forEach((row, i) => {
    if (!arraysEqualFirstVals(cellsToSearchOn, row.slice(leftOffset), cellsToSearchOn.length)) return;
    const d = dates[i][0];
    const t = d instanceof Date ? d.getTime() : (Date.parse(d) || 0);
    if (t >= bestTime) { bestTime = t; best = row; }
  });
  if (!best) return null;
  return {
    contents: 'Strain ' + best[leftOffset] + ' [' + best[leftOffset + 1] + '] was last requested by ' + best[0],
    date: best[1],
    return_status: best[2],
  };
}

// Emails CONFIG.requestNotifyEmails about a new request. A failed email never blocks the request.
// Addresses from Code.gs plus any set with the menu item "Set who gets request emails"
function getNotifyEmails() {
  const saved = PropertiesService.getDocumentProperties().getProperty('requestNotifyEmails') || '';
  const all = (CONFIG.requestNotifyEmails || []).concat(saved.split(','));
  return all.map(e => String(e).trim()).filter(e => e.indexOf('@') !== -1)
    .filter((e, i, arr) => arr.indexOf(e) === i);
}

// Menu item: type the addresses that get an email for each strain request
function setNotifyEmails() {
  const ui = SpreadsheetApp.getUi();
  const props = PropertiesService.getDocumentProperties();
  const current = props.getProperty('requestNotifyEmails') || '';
  const res = ui.prompt('Who gets request emails?',
    'Email addresses, separated by commas. Leave empty to turn emails off.\nNow: ' + (current || 'nobody'),
    ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;
  const list = res.getResponseText().split(',').map(e => e.trim()).filter(e => e !== '');
  const bad = list.filter(e => !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e));
  if (bad.length) {
    ui.alert('These don\'t look like email addresses: ' + bad.join(', ') + '. Nothing was changed.');
    return;
  }
  props.setProperty('requestNotifyEmails', list.join(','));
  SpreadsheetApp.getActive().toast(list.length ? 'Request emails go to: ' + list.join(', ') : 'Request emails are off.');
}

function notifyRequest(strainName, requester, rowValues) {
  const to = getNotifyEmails();
  if (!to.length) return 'No request email sent: nobody is set (menu: Set who gets request emails).';
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const requests = getRequests();
  const link = ss.getUrl() + '#gid=' + requests.getSheetId();
  const body = requester + ' requested ' + strainName + ' on ' + getDateIsoFormat() + '.\n\n' +
    'Genotype: ' + rowValues[1] + '\n' +
    'Box location: ' + rowValues[CONFIG.locationCol - 1] + '\n\n' +
    'Requests sheet: ' + link;
  try {
    MailApp.sendEmail(to.join(','), 'Strain request: ' + strainName + ' (' + requester + ')', body);
    return 'Email sent to ' + to.join(', ') + '.';
  } catch (e) {
    console.log('Request email failed: ' + e);
    return 'The request was saved, but the email failed: ' + e.message;
  }
}

// Shown when the strain isn't in the freezer: links to where it can be ordered
function showOrderDialog(strainName, source) {
  const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  const order = orderUrl(source, strainName);
  let body = '<p><b>' + esc(strainName) + '</b> has no box number, so it is not in our collection.</p>';
  if (order) {
    body += '<p><a href="' + esc(order) + '" target="_blank">' +
            (source === 'CGC' ? 'Order ' + esc(strainName) + ' from the CGC' : 'Request it from NBRP') + '</a></p>';
  } else if (source === 'Own lab') {
    body += '<p>It is one of our own strains. Ask the person who made it.</p>';
  } else {
    body += '<p>It was not found on the CGC. Ask the lab it came from.</p>';
  }
  if (source !== 'Own lab') {
    body += '<p><a href="' + esc(wormbaseUrl(strainName)) + '" target="_blank">Look it up on WormBase</a></p>';
    body += '<p><button onclick="this.disabled=true;google.script.run.startOrderStrainForm(' +
            esc(JSON.stringify(strainName)) + ')" style="padding:7px 14px;background:#1a73e8;color:#fff;' +
            'border:0;border-radius:4px;cursor:pointer">Ask for it to be ordered</button></p>';
  }
  const html = HtmlService.createHtmlOutput(
    '<div style="font-family:Arial,sans-serif;font-size:14px;line-height:1.5">' + body + '</div>')
    .setWidth(420).setHeight(source !== 'Own lab' ? 250 : 200);
  SpreadsheetApp.getUi().showModalDialog(html, 'Not available from the collection');
}

////////////////////////////////////////////////////////////////////////////
//     Ordering a strain: writes an order request into the ORDER sheet    //
////////////////////////////////////////////////////////////////////////////
// The order sheet is a separate spreadsheet (CONFIG.orderSheetUrl) with an "Orders" tab
// (column names in row 2) and a "Settings" tab (grants in A, people who order in E-F).
const ORDER_SHEET = { orders: 'Orders', settings: 'Settings', headerRow: 2, idPrefix: 'ORD-' };

function getOrderBook() {
  const url = String(CONFIG.orderSheetUrl || '').trim();
  if (!url || /PASTE_YOUR/.test(url)) {
    throw new Error('The order sheet is not connected yet. In Code.gs, paste its address into orderSheetUrl (near the top), save and try again.');
  }
  try {
    return /^https?:/.test(url) ? SpreadsheetApp.openByUrl(url) : SpreadsheetApp.openById(url);
  } catch (e) {
    throw new Error('Could not open the order sheet. Check the address in orderSheetUrl and that you can edit that sheet. (' + e.message + ')');
  }
}

// Opens the order form, filled in from the strain name given or the selected Strains row
function startOrderStrainForm(strainName) {
  let prefill = { name: '', geno: '', source: 'CGC' };
  if (typeof strainName === 'string' && strainName) {
    prefill.name = strainName;
  } else {
    const active = SpreadsheetApp.getActiveSheet();
    if (active.getName() === CONFIG.strainsSheet) {
      const r = active.getActiveCell().getRow();
      if (r > getHeaderRow()) {
        const v = active.getRange(r, 1, 1, CONFIG.strainHeaders.length).getDisplayValues()[0];
        prefill = { name: v[0].trim(), geno: v[1], source: '' };
      }
    }
  }
  if (prefill.name && !prefill.source) {
    const sheet = getStrains();
    const names = getStrainNames();
    const i = names.indexOf(prefill.name);
    const hint = i === -1 ? '' : sheet.getRange(getHeaderRow() + 1 + i, CONFIG.availabilityCol).getDisplayValue();
    prefill.source = resolveSource(prefill.name, hint);
    if (prefill.source === 'Own lab') prefill.source = 'Other lab';
  }
  const template = HtmlService.createTemplateFromFile('OrderStrain');
  template.prefill = JSON.stringify(prefill);
  SpreadsheetApp.getUi().showModalDialog(template.evaluate().setWidth(640).setHeight(600), 'Ask for a strain to be ordered');
}

// Grants for the form's dropdown, read from the order sheet's Settings tab
function getOrderFormInfo() {
  const book = getOrderBook();
  const settings = book.getSheetByName(ORDER_SHEET.settings);
  const grants = [];
  if (settings && settings.getLastRow() > 2) {
    settings.getRange(3, 1, settings.getLastRow() - 2, 1).getDisplayValues()
      .forEach(r => { if (r[0].trim()) grants.push(r[0].trim()); });
  }
  return { grants: grants, email: Session.getActiveUser().getEmail() || '', orderSheet: book.getUrl() };
}

// Called by the OrderStrain form. Adds a "Requested" row to the order sheet and emails the orderers.
function submitStrainOrder(data) {
  const strain = String(data.strain || '').trim();
  const name = String(data.name || '').trim();
  const email = String(data.email || '').trim();
  if (!/^[A-Za-z0-9_.-]+$/.test(strain)) throw new Error('Type a strain name like CB1370.');
  if (!name) throw new Error('Type your name.');
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) throw new Error('Type your email, so you hear back when it is ordered.');
  const source = String(data.source || 'CGC');
  const geno = String(data.geno || '').trim();

  const book = getOrderBook();
  const orders = book.getSheetByName(ORDER_SHEET.orders);
  if (!orders) throw new Error('The order sheet has no "' + ORDER_SHEET.orders + '" tab. Run its setup first.');
  const headers = orders.getRange(ORDER_SHEET.headerRow, 1, 1, orders.getLastColumn()).getDisplayValues()[0];
  const col = n => headers.indexOf(n) + 1;   // 0 when the column is missing
  if (!col('Order ID') || !col('Item')) throw new Error('The order sheet\'s column names are not as expected. Run "Format the sheets" there.');

  const strainsLink = SpreadsheetApp.getActiveSpreadsheet().getUrl() + '#gid=' + getStrains().getSheetId();
  const values = {
    'Request date': new Date(), 'Requested by': name, 'Requester email': email,
    'Item': 'C. elegans strain ' + strain + (geno ? ' (' + geno + ')' : ''),
    'Vendor': source, 'Catalog #': strain, 'Link': orderUrl(source, strain) || '',
    'Quantity': Number(data.quantity) || 1,
    'Unit price': data.price === '' || data.price == null ? '' : Number(data.price),
    'Grant': String(data.grant || ''), 'Notes': String(data.notes || '').trim(),
    'Status': 'Requested', 'Type': 'Strain',
  };

  const lock = LockService.getScriptLock();
  lock.waitLock(CONFIG.lockTimeoutMs);
  let id;
  try {
    const n = orders.getLastRow() - ORDER_SHEET.headerRow;
    let max = 0;
    if (n > 0) {
      orders.getRange(ORDER_SHEET.headerRow + 1, col('Order ID'), n, 1).getDisplayValues().forEach(r => {
        const m = r[0].trim().match(/^ORD-(\d+)$/);
        if (m) max = Math.max(max, parseInt(m[1], 10));
      });
    }
    id = ORDER_SHEET.idPrefix + String(max + 1).padStart(4, '0');
    values['Order ID'] = id;
    const r = orders.getLastRow() + 1;
    if (r > orders.getMaxRows()) orders.insertRowsAfter(orders.getMaxRows(), 1);
    Object.keys(values).forEach(k => { if (col(k)) orders.getRange(r, col(k)).setValue(values[k]); });
    ['Request date'].forEach(k => { if (col(k)) orders.getRange(r, col(k)).setNumberFormat('yyyy-mm-dd'); });
    if (col('Total') && col('Quantity') && col('Unit price')) {
      const q = columnLetter(col('Quantity')) + r, p = columnLetter(col('Unit price')) + r;
      orders.getRange(r, col('Total')).setFormula('=IF(OR(' + q + '="",' + p + '=""),"",' + q + '*' + p + ')');
    }
    // Link back to the strain collection
    if (col('Linked to')) orders.getRange(r, col('Linked to')).setFormula(hyperlinkFormula(strainsLink, 'Strain ' + strain));
    SpreadsheetApp.flush();
  } finally {
    lock.releaseLock();
  }

  const mail = emailOrderBookOrderers(book, orders, values);
  const msg = id + ' sent to the order sheet. ' + mail;
  SpreadsheetApp.getActive().toast(msg, 'Strain order requested', 8);
  return msg;
}

function columnLetter(n) {
  let s = '';
  for (; n > 0; n = Math.floor((n - 1) / 26)) s = String.fromCharCode(65 + (n - 1) % 26) + s;
  return s;
}

function emailOrderBookOrderers(book, orders, v) {
  const settings = book.getSheetByName(ORDER_SHEET.settings);
  const to = [];
  if (settings && settings.getLastRow() > 2) {
    settings.getRange(3, 6, settings.getLastRow() - 2, 1).getDisplayValues()
      .forEach(r => { if (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(r[0].trim())) to.push(r[0].trim()); });
  }
  if (!to.length) return 'No email sent: add the people who place orders in the order sheet\'s Settings tab.';
  try {
    MailApp.sendEmail({
      to: to.join(','),
      replyTo: v['Requester email'],
      subject: 'Order request ' + v['Order ID'] + ': ' + v['Item'] + ' (' + v['Requested by'] + ')',
      body: v['Requested by'] + ' asked for a strain to be ordered.\n\n' +
        'Strain: ' + v['Catalog #'] + '\nFrom: ' + v['Vendor'] + (v['Link'] ? '\nOrder page: ' + v['Link'] : '') +
        '\nGrant: ' + (v['Grant'] || '-') + (v['Notes'] ? '\nNotes: ' + v['Notes'] : '') +
        '\n\nOrder sheet: ' + book.getUrl() + '#gid=' + orders.getSheetId(),
    });
    return 'Email sent to ' + to.join(', ') + '.';
  } catch (e) {
    console.log('Order email failed: ' + e);
    return 'The order was saved, but the email failed: ' + e.message;
  }
}

// Request the strain on the current active row of the Strains sheet
function request() {
  const ui = SpreadsheetApp.getUi();
  const sheet = getStrains();
  if (SpreadsheetApp.getActiveSheet().getName() !== sheet.getName()) {
    ui.alert('Select a row on the "' + CONFIG.strainsSheet + '" sheet first.');
    return;
  }
  const rowNumber = sheet.getActiveCell().getRow();
  const selectedRow = sheet.getRange(rowNumber, 1, 1, CONFIG.strainHeaders.length);
  const rowValues = selectedRow.getDisplayValues()[0];
  if (rowNumber <= getHeaderRow() || !rowValues[0]) {
    ui.alert('Select a strain row first.');
    return;
  }
  const strainName = rowValues[0].trim();
  const cellsToSearchOn = rowValues.slice(0, CONFIG.nbColsToCompare);
  const location = rowValues[CONFIG.locationCol - 1];
  const source = resolveSource(strainName, rowValues[CONFIG.availabilityCol - 1]);

  if (isLocationMissing(location)) {
    showOrderDialog(strainName, source);
    return;
  }

  const targetSheet = getRequests();
  const lastRequest = findLastTimeRequested(targetSheet, cellsToSearchOn);
  const stillOut = lastRequest != null && /^\s*no/i.test(lastRequest.return_status);
  if (stillOut) {
    ui.alert(lastRequest.contents + '\nRequest date: ' + lastRequest.date +
             '\nReturned: ' + lastRequest.return_status);
    return;
  }

  let prompt = 'What is your name?';
  if (lastRequest != null) {
    prompt = 'This strain has been requested before.\n\n' + lastRequest.contents +
             '\nRequest date: ' + lastRequest.date + '\nReturned: ' + lastRequest.return_status +
             '\n\nWhat is your name, assuming you still want it from the collection?';
  }
  const response = ui.prompt('Request ' + rowValues[0], prompt, ui.ButtonSet.OK_CANCEL);
  const yourName = response.getResponseText().trim();
  if (response.getSelectedButton() !== ui.Button.OK || yourName === '') return;

  withLock(() => {
    const newRow = targetSheet.getLastRow() + 1;
    if (newRow > targetSheet.getMaxRows()) targetSheet.insertRowsAfter(targetSheet.getMaxRows(), 1);
    targetSheet.getRange(newRow, 1, 1, CONFIG.requestInfoCols)
      .setValues([[yourName, new Date(), 'no']])
      .setFontWeight('bold');
    targetSheet.getRange(newRow, 2).setNumberFormat(DATE_FORMAT);
    selectedRow.copyTo(targetSheet.getRange(newRow, CONFIG.requestInfoCols + 1),
                       SpreadsheetApp.CopyPasteType.PASTE_VALUES, false);
    // Clickable Source / Order / WormBase links for this strain on the Requests row
    writeLinkCells(targetSheet, newRow, source, strainName);
    const dateVersion = accessDateAndVersion(true);
    targetSheet.getRange(1, 2).setValue(dateVersion[0]);
  });
  const emailNote = notifyRequest(strainName, yourName, rowValues);
  SpreadsheetApp.getActive().toast(rowValues[0] + ' requested by ' + yourName + '. ' + emailNote +
    ' Change "no" to "yes" in the ' + CONFIG.requestsSheet + ' sheet when you return it.', 'Request saved', 10);
}

