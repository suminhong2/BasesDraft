////////////////////////////////////////////////////////////////////////////
//  One-time setup: lays out a blank spreadsheet the way this script     //
//  expects. Only creates sheets that don't exist yet.                    //
////////////////////////////////////////////////////////////////////////////
function setupCollection() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss.getSheetByName(CONFIG.strainsSheet)) {
    const s = ss.insertSheet(CONFIG.strainsSheet);
    // Row 2: lab name, lab code, allele code, last edited date; I3: version
    s.getRange('C2').setValue(CONFIG.labName);
    s.getRange('E2').setValue(CONFIG.labCode || 'REC');
    s.getRange('G2').setValue(CONFIG.alleleCode || 'vrt');
    s.getRange('I2:I3').setValues([[getDateIsoFormat()], [1]]);
    writeStrainTypes(s);
    s.getRange(CONFIG.headerRow, 1, 1, CONFIG.strainHeaders.length).setValues([CONFIG.strainHeaders]);
  }
  if (!ss.getSheetByName(CONFIG.requestsSheet)) {
    const r = ss.insertSheet(CONFIG.requestsSheet);
    r.getRange('A1:B1').setValues([['Last updated', getDateIsoFormat()]]);
  }
  addLinkColumns();
  formatSheets();
  SpreadsheetApp.getActive().toast('Collection sheets are ready. Edit the lab code, allele code and transgene table on the Strains sheet.');
}

////////////////////////////////////////////////////////////////////////////
//  Look of the sheets: light settings area, striped table. Only changes  //
//  formatting, never data, so it is safe to run again at any time.       //
////////////////////////////////////////////////////////////////////////////
// Colors used by "Format the sheets". Change them here to restyle every sheet.
const THEME = {
  header: '#2c5f6e',      // column-name row: deep teal with white text
  headerText: '#ffffff',
  settings: '#eef4f5',    // the settings area at the top (codes, next numbers)
  settingsText: '#3b4d52',
  valueBorder: '#9fbcc3', // boxes around the cells people edit up there
  stripe: '#f5f9fa',      // every other strain row
  grid: '#dde6e8',
};
const COLUMN_WIDTHS = [95, 260, 120, 230, 90, 400, 280, 170, 90, 105, 65, 85, 110, 90];
// Short values are centered; long text (alleles, DNA, notes, maintenance, generated by) is left-aligned
const LEFT_ALIGNED_COLS = [2, 4, 6, 7, 8];

function formatSheets() {
  addLinkColumns();
  formatStrainsSheet();
  formatRequestsSheet();
  formatPrefixesSheet();
  SpreadsheetApp.getActive().toast('Sheets formatted.');
}

// Header row, stripes, filter buttons and column layout for a table starting at headerRow.
// firstDataCol shifts the column layout (the Requests sheet has 3 request columns first).
function styleTable(sheet, headerRow, nCols, firstDataCol) {
  const rows = Math.max(sheet.getMaxRows() - headerRow, 1);
  const table = sheet.getRange(headerRow, 1, rows + 1, nCols);
  sheet.getBandings().forEach(b => b.remove());
  table.clearFormat();
  table.setFontFamily('Arial').setFontSize(10).setVerticalAlignment('middle').setWrap(true);
  table.applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, true, false)
    .setHeaderRowColor(THEME.header).setFirstRowColor('#ffffff').setSecondRowColor(THEME.stripe);
  sheet.getRange(headerRow, 1, 1, nCols).setFontColor(THEME.headerText).setFontWeight('bold')
    .setHorizontalAlignment('center');
  sheet.setRowHeight(headerRow, 40);
  const body = sheet.getRange(headerRow + 1, 1, rows, nCols);
  body.setHorizontalAlignment('center')
    .setBorder(null, null, true, null, null, true, THEME.grid, SpreadsheetApp.BorderStyle.SOLID);
  LEFT_ALIGNED_COLS.forEach(c => {
    const col = c + firstDataCol - 1;
    if (col <= nCols) sheet.getRange(headerRow + 1, col, rows, 1).setHorizontalAlignment('left');
  });
  // Filter buttons on the column names, for sorting and searching
  if (!sheet.getFilter()) table.createFilter();
  sheet.setFrozenRows(headerRow);
}

function formatStrainsSheet() {
  const s = getStrains();
  const header = getHeaderRow();
  const nCols = CONFIG.strainHeaders.length;
  s.getRange(header, 1, 1, nCols).setValues([CONFIG.strainHeaders]);

  // Settings area: lab name, codes, date/version and the next-number table
  const top = s.getRange(1, 1, header - 1, nCols);
  top.clearFormat();
  top.setBackground(THEME.settings).setFontColor(THEME.settingsText).setFontFamily('Arial').setFontSize(10)
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
  const valueCells = ['C2', 'E2', 'G2', 'I2', 'I3'].map(a1 => s.getRange(a1));
  const nTypes = getTransgeneRange().getNumColumns();
  valueCells.push(s.getRange(CONFIG.transgeneFirstRow + 2, 1, 1, nTypes));
  valueCells.forEach(r => r.setBackground('#ffffff').setFontColor('#000000').setFontWeight('bold')
    .setBorder(true, true, true, true, true, null, THEME.valueBorder, SpreadsheetApp.BorderStyle.SOLID));
  s.getRange(CONFIG.transgeneFirstRow, 1, 2, nTypes).setFontWeight('bold');
  s.getRange(CONFIG.transgeneFirstRow, 1, 2, 1).setFontSize(8).setFontWeight('normal');

  styleTable(s, header, nCols, 1);
  const rows = Math.max(s.getMaxRows() - header, 1);
  s.getRange(header + 1, 1, rows, 1).setFontWeight('bold');                // strain number
  s.getRange(header + 1, 5, rows, 1).setNumberFormat(DATE_FORMAT);         // record date (time kept, hidden)
  s.setFrozenColumns(1);
  COLUMN_WIDTHS.slice(0, nCols).forEach((w, i) => s.setColumnWidth(i + 1, w));
}

function formatRequestsSheet() {
  const r = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.requestsSheet);
  if (!r) return;
  const hdr = CONFIG.requestHeaderRows;
  const info = CONFIG.requestInfoCols;
  const nCols = requestLinkCol() + 2;
  r.getRange(1, 1, 1, 2).setFontWeight('bold').setFontColor(THEME.settingsText);
  styleTable(r, hdr, nCols, info + 1);
  r.getRange(hdr + 1, 1, r.getMaxRows() - hdr, 1).setFontWeight('bold');
  r.getRange(hdr + 1, info + 1, r.getMaxRows() - hdr, 1).setFontWeight('bold');
  r.getRange(hdr + 1, 2, r.getMaxRows() - hdr, 1).setNumberFormat(DATE_FORMAT);         // request date
  r.getRange(hdr + 1, info + 5, r.getMaxRows() - hdr, 1).setNumberFormat(DATE_FORMAT);  // record date
  [120, 95, 85].concat(COLUMN_WIDTHS).slice(0, nCols).forEach((w, i) => r.setColumnWidth(i + 1, w));

  // "Returned?" column: yes / no dropdown, red while a strain is still out, green once back
  const returned = r.getRange(hdr + 1, 3, r.getMaxRows() - hdr, 1);
  returned.setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['no', 'yes'], true).build());
  const a1 = returned.getA1Notation();
  const rules = r.getConditionalFormatRules().filter(rule => !rule.getRanges().some(g => g.getA1Notation() === a1));
  rules.push(SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('no')
    .setBackground('#f4cccc').setFontColor('#990000').setBold(true).setRanges([returned]).build());
  rules.push(SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('yes')
    .setBackground('#d9ead3').setFontColor('#274e13').setRanges([returned]).build());
  r.setConditionalFormatRules(rules);
}

function formatPrefixesSheet() {
  const p = getPrefixesSheet();
  styleTable(p, 1, 5, 99);
  p.getRange(2, 1, Math.max(p.getMaxRows() - 1, 1), 1).setFontWeight('bold');
  [80, 200, 95, 260, 110].forEach((w, i) => p.setColumnWidth(i + 1, w));
}

// Writes CONFIG.strainTypes and the first strain number into rows 4-6 of the Strains sheet
function writeStrainTypes(sheet) {
  const types = CONFIG.strainTypes;
  sheet.getRange(CONFIG.transgeneFirstRow, 1, 3, CONFIG.transgeneMaxCols).clearContent();
  sheet.getRange(CONFIG.transgeneFirstRow, 1, 3, types.length + 1).setValues([
    ['Next free # on line below'].concat(types.map(t => t[0])),
    ['Strain number'].concat(types.map(t => t[1])),
    [CONFIG.firstStrainNumber].concat(types.map(t => t[2])),
  ]);
}

// Menu item: puts the strain types from CONFIG on the sheet and restarts numbering
function resetStrainTypes() {
  const ui = SpreadsheetApp.getUi();
  const answer = ui.alert('Reset strain types and numbers?',
    'This writes the strain types from Code.gs into rows 4-6 and sets the next strain to ' +
    getPrefixes()[0] + CONFIG.firstStrainNumber + '. Only do this before you add real strains, ' +
    'or numbers will repeat.', ui.ButtonSet.YES_NO);
  if (answer !== ui.Button.YES) return;
  withLock(() => writeStrainTypes(getStrains()));
  SpreadsheetApp.getActive().toast('Strain types reset. Next strain: ' + getPrefixes()[0] + CONFIG.firstStrainNumber);
}

// Adds the Source / Order / WormBase headers and the Source dropdown.
// Safe to run on a sheet that already has data: it only writes empty header cells.
function addLinkColumns() {
  const s = getStrains();
  const headerRow = getHeaderRow();
  const below = s.getMaxRows() - headerRow;
  // An earlier version put a Source dropdown in column K ("# of vials"); take it off there
  const oldK = s.getRange(headerRow + 1, 11, below, 1);
  const oldRule = oldK.getCell(1, 1).getDataValidation();
  if (oldRule && String(oldRule.getCriteriaValues()[0]) === String(SOURCES)) oldK.clearDataValidations();
  // ...and later in columns L-N. Those links now live on the Requests sheet only.
  const oldLinks = s.getRange(headerRow, 12, below + 1, 3);
  if (oldLinks.getDisplayValues()[0][0] === 'Source') {
    oldLinks.clearContent().clearDataValidations().clearFormat();
  }
  const r = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.requestsSheet);
  if (r) {
    const headers = ['Requested by', 'Request date', 'Returned?'].concat(CONFIG.strainHeaders, ['Source', 'Order link', 'WormBase']);
    r.getRange(CONFIG.requestHeaderRows, 1, 1, headers.length).setValues([headers]);
  }
}

