    .addSeparator()
    .addItem('Go to the last line in the current sheet', 'goToLastLine')
    .addItem('Sort newest first', 'sortNewestFirst')
    .addItem('Sort oldest first', 'sortOldestFirst')
    .addSeparator()
    .addItem('Create a backup now', 'createBackupFromMenu')
    .addItem('Set up blank collection sheets', 'setupCollection')
    .addItem('Format the sheets', 'formatSheets')
